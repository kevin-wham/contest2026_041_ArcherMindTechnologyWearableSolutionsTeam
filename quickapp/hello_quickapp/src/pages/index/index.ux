<template>
  <div class="container">
    <!-- 顶部标题：菜单 -->
    <div class="top-bar">
      <text class="menu-title">菜单</text>
    </div>

    <!-- 日期 -->
    <text class="date-text">{{ currentDate }}</text>

    <!-- 功能菜单 2x2 网格 -->
    <div class="menu-grid">
      <div class="menu-row">
        <div class="menu-item" onclick="openHealth">
          <div class="menu-icon health-icon">
            <image src="/common/images/icons/heart-rate.png" class="icon-img"></image>
          </div>
          <text class="menu-name">健康</text>
        </div>

        <div class="menu-item" onclick="openSOS">
          <div class="menu-icon call-icon">
            <text class="icon-text">☎</text>
          </div>
          <text class="menu-name">求助</text>
        </div>
      </div>

      <div class="menu-row">
        <div class="menu-item" onclick="openSteps">
          <div class="menu-icon steps-icon">
            <image src="/common/images/icons/steps.png" class="icon-img"></image>
          </div>
          <text class="menu-name">运动</text>
        </div>
      </div>

        <div class="menu-item" onclick="openSettings">
          <div class="menu-icon settings-icon">
            <image src="/common/images/icons/settings.png" class="icon-img"></image>
          </div>
          <text class="menu-name">设置</text>
        </div>
      </div>
    </div>

    <!-- 底部心率胶囊 -->
    <div class="bottom-vital" onclick="onVitalTap('heartRate')">
      <div class="hr-pill">
        <image src="/common/images/icons/heart-rate.png" class="hr-icon"></image>
        <text class="hr-value">{{ heartRateDisplay }}</text>
        <text class="hr-unit">次/分</text>
      </div>
    </div>
  </div>
</template>

<style>
.container {
  width: 466px;
  height: 466px;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  padding-top: 60px;
  padding-bottom: 60px;
  padding-left: 60px;
  padding-right: 60px;
}

.top-bar {
  width: 100%;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
}

.menu-title {
  font-size: 16px;
  color: rgba(125, 211, 252, 0.8);
  padding-left: 14px;
  padding-right: 14px;
  padding-top: 4px;
  padding-bottom: 4px;
  border-radius: 14px;
  background-color: rgba(255, 255, 255, 0.08);
}

.date-text {
  font-size: 26px;
  color: #7dd3fc;
  margin-bottom: 18px;
}

.menu-grid {
  flex-direction: column;
  align-items: center;
  margin-bottom: 18px;
}

.menu-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 10px;
  margin-bottom: 10px;
}

.menu-item {
  flex-direction: column;
  align-items: center;
  margin-left: 18px;
  margin-right: 18px;
}

.menu-icon {
  width: 76px;
  height: 76px;
  border-radius: 22px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.icon-img {
  width: 40px;
  height: 40px;
}

.icon-text {
  font-size: 38px;
  color: #ffffff;
}

.health-icon {
  background-color: #7f1d1d;
}

.call-icon {
  background-color: #1e3a5f;
}

.steps-icon {
  background-color: #14532d;
}

.settings-icon {
  background-color: #c2410c;
}

.menu-name {
  font-size: 18px;
  color: #e2e8f0;
  margin-top: 8px;
}

.bottom-vital {
  width: 100%;
  flex-direction: row;
  justify-content: center;
}

.hr-pill {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 40px;
  padding-left: 28px;
  padding-right: 28px;
  padding-top: 14px;
  padding-bottom: 14px;
}

.hr-icon {
  width: 34px;
  height: 34px;
  margin-right: 10px;
}

.hr-value {
  font-size: 46px;
  color: #ffffff;
  font-weight: 700;
}

.hr-unit {
  font-size: 18px;
  color: #94a3b8;
  margin-left: 6px;
}
</style>

<script>
import router from '@system.router'
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import { VITAL_RANGES, STORAGE_KEYS, UPLOAD_MODE, VITAL_UPLOAD_INTERVAL } from '../../utils/constants'
import { HealthRulesEngine, FallDetector } from '../../utils/health-rules'
import SensorService from '../../services/SensorService'
import DataCache from '../../services/DataCache'
import UploadService from '../../services/UploadService'
import AlarmService from '../../services/AlarmService'
import MqttService from '../../services/MqttService'
import cloudService from '../../services/CloudService'
import deviceBinding from '../../services/DeviceBindingService'
import signinService from '../../services/SigninService'

export default {
  private: {
    // 体征数据
    heartRate: -1,
    spo2: -1,
    temperature: -1,
    heartRateStatus: 'normal',
    spo2Status: 'normal',
    temperatureStatus: 'normal',

    // 活动数据
    steps: 0,
    activeMinutes: 0,
    calories: 0,
    goalSteps: 6000,

    // 位置数据
    lastLocation: null,

    // 数据来源
    dataSource: 'mock',

    // 健康提示
    healthTipMessage: '',
    healthTipLevel: 'info',

    // 系统状态
    isNetworkAvailable: true,
    batteryLevel: 100,
    currentTime: '--:--',
    currentDate: '--月--日',
    lastUpdateTime: 0,
    uploadMode: 'http',       // 当前上传模式
    mqttConnected: false,     // MQTT 连接状态

    // 云端连接状态（服务器登录 + WebSocket 实时通道）
    cloudLoggedIn: false,
    cloudWsConnected: false,
    cloudStatusText: '正在登录服务器…',
    cloudListener: null,

    // 今日签到状态
    signinDone: false,
    signinText: '今日未签到',
    autoSigninBusy: false,

    // 定时器
    dataTimer: null,
    uploadTimer: null,
    uploadBusy: false,
    timeTimer: null,

    // 服务实例
    sensorService: null,
    dataCache: null,
    uploadService: null,
    alarmService: null,
    mqttService: null,
    healthRules: null,
    fallDetector: null,

    // SOS 长按相关
    sosPressTimer: null,
    sosLongPressThreshold: 1500,

    // 报警页跳转冷却（避免频繁跳转）
    lastAlarmNavigateTime: 0,
    alarmNavigateCooldown: 60000
  },

  computed: {
    heartRateDisplay() {
      return this.heartRate > 0 ? this.heartRate : '--'
    },
    spo2Display() {
      return this.spo2 > 0 ? this.spo2 + '%' : '--%'
    },
    temperatureDisplay() {
      return this.temperature > 0 ? this.temperature.toFixed(1) + '°C' : '--°C'
    },
    progressWidth() {
      const progress = Math.min(this.steps / this.goalSteps, 1)
      return Math.floor(progress * 250)
    }
  },

  onInit() {
    this.initServices()
    this.loadSettings()
    this.updateTime()
  },

  onShow() {
    // 重新加载设置，确保数据来源配置是最新的
    this.loadSettings()
    // 早晨未签到时自动跳转到每日签到页
    this.checkMorningCheckIn()
    // 重新加载上传模式（用户可能在设置页修改了）
    this._loadUploadModeConfig()
    // 立刻同步当前上传模式（避免异步竞态）
    if (this.uploadService) {
      this.uploadMode = this.uploadService.getUploadMode()
    }
    // 检查是否有来自设置页的 MQTT 命令
    this._checkMqttCommand()
    // 重新初始化传感器服务（如果配置变了会自动切换）
    this.sensorService.reload({
      onHeartRate: (data) => {
        this.heartRate = data.heartRate
        this.updateHealthStatus()
        this.cacheVitalData()
        this.checkAlarms()
      },
      onSpO2: (data) => {
        this.spo2 = data.spo2
        this.updateHealthStatus()
        this.cacheVitalData()
        this.checkAlarms()
      },
      onTemperature: (data) => {
        this.temperature = data.temperature
        this.updateHealthStatus()
        this.cacheVitalData()
        this.checkAlarms()
      },
      onAccelerometer: (data) => {
        this.fallDetector.addAcceleration(data)
        this.checkFallDetection()
      },
      onSteps: (data) => {
        this.steps = data.steps
        this.updateActivityStats()
      },
      onLocation: (data) => {
        this.lastLocation = data
      }
    })
    this.dataSource = this.sensorService.getDataSource()
    this.startTimers()
  },

  onHide() {
    this.stopDataCollection()
    this.stopTimers()
  },

  onDestroy() {
    this.stopDataCollection()
    this.stopTimers()
    // 仅解绑页面监听，保留全局云端连接（SOS 页仍需下发报警）
    if (this.cloudListener) {
      cloudService.offStatusChange(this.cloudListener)
      this.cloudListener = null
    }
    this.cleanupServices()
  },

  /**
   * 初始化所有服务
   */
  initServices() {
    // 健康规则引擎
    this.healthRules = new HealthRulesEngine()

    // 跌倒检测器
    this.fallDetector = new FallDetector()

    // 数据缓存服务
    this.dataCache = new DataCache()
    this.dataCache.init(() => {
      this.loadCachedData()
    })

    // 上传服务
    this.uploadService = new UploadService()
    this.uploadService.init({
      onNetworkChange: (available) => {
        this.isNetworkAvailable = available
      }
    })

    // MQTT 服务
    this.mqttService = new MqttService()
    this.mqttService.init({
      onStatusChange: (connected, info) => {
        this.mqttConnected = connected
        console.log(`[Index] MQTT 状态: ${info}`)
        // 写入 storage，供设置页读取
        storage.set({
          key: 'mqtt_status',
          value: JSON.stringify({ connected, info, time: Date.now() }),
          success: () => {},
          fail: () => {}
        })
        // 连接成功后上报一次在线数据
        if (connected) {
          this._publishOnline()
          // 补传离线期间的签到记录
          this._flushPendingSignin()
        }
      },
      onError: (error) => {
        console.error(`[Index] MQTT 错误: ${error}`)
      }
    })

    // 绑定 MQTT 到上传服务
    this.uploadService.setMqttService(this.mqttService)

    // 加载上传模式配置
    this._loadUploadModeConfig()

    // 报警服务
    this.alarmService = new AlarmService(this.uploadService)
    this.alarmService.init({
      onSOS: () => {
        console.log('SOS 报警已触发')
      }
    })

    // 传感器服务
    this.sensorService = new SensorService()
    this.sensorService.init(() => {
      this.dataSource = this.sensorService.getDataSource()
      console.log(`数据来源: ${this.dataSource === 'mock' ? '模拟数据' : '真实传感器'}`)
    })

    // 云端连接：登录服务器 + 建立 WebSocket
    this.initCloudConnection()
  },

  /**
   * 初始化云端连接（第一步：登录服务器并建立 WebSocket 长连接）
   */
  initCloudConnection() {
    cloudService.init({
      onAlarmMessage: (alarm) => {
        console.log(`[Index] 收到服务器报警推送: ${alarm && alarm.alarm_type}`)
      }
    })

    this.cloudListener = (state) => {
      this.cloudLoggedIn = state.loggedIn
      this.cloudWsConnected = state.wsConnected

      if (!state.loggedIn) {
        this.cloudStatusText = state.lastError ? '服务器未连接' : '登录服务器中…'
      } else if (state.wsConnected) {
        this.cloudStatusText = '云端在线 · ' + state.username
      } else {
        this.cloudStatusText = '已登录 · 实时通道重连中'
      }

      // 与服务器连接成功 → 自动签到（幂等，今日已同步则跳过）
      if (state.loggedIn) {
        this.autoCheckIn()
      }
    }

    cloudService.onStatusChange(this.cloudListener)
    this.cloudListener(cloudService.getStatus())
    cloudService.start()
  },

  /**
   * 确保云端在线（网络恢复 / 页面回来时调用）
   */
  ensureCloudOnline() {
    if (!cloudService.isOnline()) {
      cloudService.ensureOnline()
    }
  },

  /**
   * 加载上传模式配置（从 storage 读取并同步到 UploadService）
   */
  _loadUploadModeConfig() {
    storage.get({
      key: STORAGE_KEYS.UPLOAD_MODE,
      success: (data) => {
        if (data === UPLOAD_MODE.HTTP || data === UPLOAD_MODE.MQTT) {
          this.uploadMode = data
          this.uploadService.setUploadMode(data)

          // MQTT 模式下自动连接
          if (data === UPLOAD_MODE.MQTT) {
            console.log('[Index] MQTT 模式，尝试连接...')
            this.mqttService.connect()
          }
        }
      },
      fail: () => {}
    })
  },

  /**
   * 检查来自设置页的 MQTT 命令
   */
  _checkMqttCommand() {
    storage.get({
      key: 'mqtt_cmd',
      success: (data) => {
        if (data === 'connect' || data === 'reconnect') {
          const isReconnect = data === 'reconnect'
          console.log('[Index] 收到 MQTT ' + (isReconnect ? '重连' : '连接') + '命令')
          // 清除命令
          storage.delete({
            key: 'mqtt_cmd',
            success: () => {},
            fail: () => {}
          })
          if (!this.mqttService) return

          if (isReconnect) {
            // 序列号变化后 Topic 改变，需要断开重连
            this.mqttService.disconnect()
            setTimeout(() => {
              if (this.mqttService) this.mqttService.connect()
            }, 500)
          } else if (!this.mqttService.isConnected()) {
            this.mqttService.connect()
          }
        }
      },
      fail: () => {}
    })
  },

  /**
   * MQTT 连接成功后上报设备在线数据
   */
  _publishOnline() {
    if (!this.mqttService) return

    const { API_CONFIG } = require('../../utils/constants')
    const { MQTT_TOPICS } = API_CONFIG

    // 使用当前绑定的序列号（设置页可修改）
    const deviceSn = deviceBinding.getDeviceSN()

    const packet = {
      device_sn: deviceSn,
      elderly_id: deviceBinding.getElderlyId(),
      firmware_version: '1.0.0'
    }

    this.mqttService.publish(MQTT_TOPICS.ONLINE(deviceSn), packet)
    console.log(`[Index] 设备上线已上报 → device/${deviceSn}/online`)
  },

  /**
   * 检查早晨签到：每天 06:00-10:00 未签到时自动跳转签到页
   */
  checkMorningCheckIn() {
    const hour = new Date().getHours()
    if (hour < 6 || hour >= 10) return

    const today = new Date().toDateString()
    storage.get({
      key: STORAGE_KEYS.CHECKIN_DATE,
      success: (data) => {
        if (data !== today) {
          router.push({
            uri: '/pages/checkin'
          })
        }
      },
      fail: () => {}
    })
  },

  /**
   * 自动签到：开机连上服务器后，若今日未签到则自动完成
   *   - 今日已签到且已同步 → 跳过
   *   - 今日已签到但未同步 → 重试上报
   *   - 今日未签到 → 生成记录、本地保存并上报
   */
  autoCheckIn() {
    if (this.autoSigninBusy) return
    this.autoSigninBusy = true

    const today = new Date().toDateString()

    storage.get({
      key: STORAGE_KEYS.SIGNIN_RECORD,
      success: (data) => {
        let record = null
        if (data) {
          try {
            record = JSON.parse(data)
          } catch (e) {
            record = null
          }
        }

        if (record && record.date === today) {
          if (record.synced) {
            console.log('[AutoSignin] 今日已签到并已同步，跳过')
            this.autoSigninBusy = false
            return
          }
          // 失败后 60s 内不重复上报，避免连接抖动时频繁请求
          if (record.lastTry && Date.now() - record.lastTry < 60000) {
            this.autoSigninBusy = false
            return
          }
          console.log('[AutoSignin] 今日已签到但未同步，重试上报')
          this._reportSignin(record)
          return
        }

        this._doAutoCheckIn()
      },
      fail: () => this._doAutoCheckIn()
    })
  },

  /**
   * 执行自动签到（生成记录 + 本地持久化 + 上报）
   */
  _doAutoCheckIn() {
    const now = new Date()
    const hh = now.getHours().toString().padStart(2, '0')
    const mi = now.getMinutes().toString().padStart(2, '0')

    const record = {
      date: now.toDateString(),
      time: `${hh}:${mi}`,
      timestamp: now.getTime(),
      method: 'auto',
      synced: false
    }

    console.log(`[AutoSignin] 自动签到成功（本地） ${record.time}`)

    storage.set({
      key: STORAGE_KEYS.SIGNIN_RECORD,
      value: JSON.stringify(record),
      success: () => {},
      fail: (data, code) => console.error(`[AutoSignin] 保存签到记录失败: code=${code}`)
    })
    // 兼容旧键（早晨自动跳转逻辑依赖）
    storage.set({
      key: STORAGE_KEYS.CHECKIN_DATE,
      value: record.date,
      success: () => {},
      fail: () => {}
    })

    // 立即刷新界面
    this.signinDone = true
    this.signinText = `今日已签到 ${record.time}`

    this._reportSignin(record)
  },

  /**
   * 上报签到记录：MQTT 优先，HTTP 兜底，失败进入待同步队列
   */
  _reportSignin(record) {
    let finished = false
    const done = () => {
      if (finished) return
      finished = true
      this.autoSigninBusy = false
    }

    // 1) MQTT 模式且长连接已建立
    if (this.uploadMode === UPLOAD_MODE.MQTT && this.mqttService && this.mqttService.isConnected()) {
      const { API_CONFIG } = require('../../utils/constants')
      const deviceSn = deviceBinding.getDeviceSN()

      this.mqttService.publish(API_CONFIG.MQTT_TOPICS.SIGNIN(deviceSn), {
        device_sn: deviceSn,
        elderly_id: deviceBinding.getElderlyId(),
        method: record.method || 'auto',
        timestamp: record.timestamp || Date.now()
      })
      console.log('[AutoSignin] 签到已通过 MQTT 上报')
      this._markSigninSynced(record)
      done()
      return
    }

    // 2) HTTP 代签到接口
    signinService.report(record, (err) => {
      if (err) {
        console.warn('[AutoSignin] 签到上报失败: ' + (err.message || err))
        this._enqueueSignin(record)
        this._markSigninRetry(record)
      } else {
        console.log('[AutoSignin] 签到已同步到服务器')
        this._markSigninSynced(record)
      }
      done()
    })

    // 3) 超时兜底，避免阻塞后续状态变化时的重试
    setTimeout(done, 15000)
  },

  /**
   * 标记本地签到记录为已同步
   */
  _markSigninSynced(record) {
    const synced = Object.assign({}, record, { synced: true })
    storage.set({
      key: STORAGE_KEYS.SIGNIN_RECORD,
      value: JSON.stringify(synced),
      success: () => {},
      fail: () => {}
    })
    this.signinDone = true
    this.signinText = record.time ? `今日已签到 ${record.time}` : '今日已签到'
  },

  /**
   * 记录一次上报尝试时间（用于失败冷却）
   */
  _markSigninRetry(record) {
    const retried = Object.assign({}, record, { synced: false, lastTry: Date.now() })
    storage.set({
      key: STORAGE_KEYS.SIGNIN_RECORD,
      value: JSON.stringify(retried),
      success: () => {},
      fail: () => {}
    })
  },

  /**
   * 签到记录进入待同步队列（下次联网或 MQTT 连接后补传）
   */
  _enqueueSignin(record) {
    storage.get({
      key: STORAGE_KEYS.SIGNIN_PENDING,
      success: (data) => {
        let list = []
        if (data) {
          try {
            list = JSON.parse(data)
          } catch (e) {
            list = []
          }
        }
        if (!Array.isArray(list)) list = []
        list.push(record)
        if (list.length > 50) list = list.slice(-50)

        storage.set({
          key: STORAGE_KEYS.SIGNIN_PENDING,
          value: JSON.stringify(list),
          success: () => {},
          fail: () => {}
        })
      },
      fail: () => {
        storage.set({
          key: STORAGE_KEYS.SIGNIN_PENDING,
          value: JSON.stringify([record]),
          success: () => {},
          fail: () => {}
        })
      }
    })
  },

  /**
   * 刷新今日签到状态（今日已签到 HH:mm / 今日未签到）
   */
  refreshSigninStatus() {
    const today = new Date().toDateString()

    storage.get({
      key: STORAGE_KEYS.SIGNIN_RECORD,
      success: (data) => {
        if (data) {
          try {
            const record = JSON.parse(data)
            if (record && record.date === today) {
              this.signinDone = true
              this.signinText = record.time ? `今日已签到 ${record.time}` : '今日已签到'
              return
            }
          } catch (e) {
            console.warn('[Index] 签到记录解析失败')
          }
        }

        // 兼容旧版本只存了 checkin_date
        storage.get({
          key: STORAGE_KEYS.CHECKIN_DATE,
          success: (value) => {
            this.signinDone = value === today
            this.signinText = this.signinDone ? '今日已签到' : '今日未签到'
          },
          fail: () => {
            this.signinDone = false
            this.signinText = '今日未签到'
          }
        })
      },
      fail: () => {
        this.signinDone = false
        this.signinText = '今日未签到'
      }
    })
  },

  /**
   * 进入每日签到页
   */
  openCheckIn() {
    router.push({
      uri: '/pages/checkin'
    })
  },

  /**
   * 补传待同步的签到记录
   *   服务端签到记录由 MQTT topic device/{sn}/signin 写入，
   *   因此仅在 MQTT 模式且连接成功后补传。
   */
  _flushPendingSignin() {
    storage.get({
      key: STORAGE_KEYS.SIGNIN_PENDING,
      success: (data) => {
        let list = []
        if (data) {
          try {
            list = JSON.parse(data)
          } catch (e) {
            list = []
          }
        }
        if (!Array.isArray(list) || list.length === 0) return

        // MQTT 模式且已连接：走 topic device/{sn}/signin
        if (this.uploadMode === UPLOAD_MODE.MQTT && this.mqttService && this.mqttService.isConnected()) {
          const { API_CONFIG } = require('../../utils/constants')
          const deviceSn = deviceBinding.getDeviceSN()

          list.forEach((record) => {
            this.mqttService.publish(API_CONFIG.MQTT_TOPICS.SIGNIN(deviceSn), {
              device_sn: deviceSn,
              elderly_id: deviceBinding.getElderlyId(),
              method: (record && record.method) || 'manual',
              timestamp: (record && record.timestamp) || Date.now()
            })
          })

          console.log(`[Index] 已补传 ${list.length} 条签到记录（MQTT）`)
          storage.delete({
            key: STORAGE_KEYS.SIGNIN_PENDING,
            success: () => {},
            fail: () => {}
          })
          return
        }

        // HTTP 兜底：用代签到接口补传最近一条
        const latest = list[list.length - 1]
        signinService.report(latest, (err) => {
          if (err) {
            console.warn('[Index] 签到补传失败: ' + (err.message || err))
            return
          }
          console.log('[Index] 签到记录已补传到服务器（HTTP）')
          storage.delete({
            key: STORAGE_KEYS.SIGNIN_PENDING,
            success: () => {}
          })
          // 若补传的是今日记录，标记为已同步，避免重复上报
          storage.get({
            key: STORAGE_KEYS.SIGNIN_RECORD,
            success: (data) => {
              if (!data) return
              try {
                const record = JSON.parse(data)
                if (record && latest && record.date === latest.date) {
                  this._markSigninSynced(record)
                  return
                }
              } catch (e) {}
              this.refreshSigninStatus()
            },
            fail: () => this.refreshSigninStatus()
          })
        })
      },
      fail: () => {}
    })
  },

  /**
   * 检查早晨签到：每天 06:00-10:00 未签到时自动跳转签到页
   */
  checkMorningCheckIn() {
    const hour = new Date().getHours()
    if (hour < 6 || hour >= 10) return

    const today = new Date().toDateString()
    storage.get({
      key: STORAGE_KEYS.CHECKIN_DATE,
      success: (data) => {
        if (data !== today) {
          router.push({
            uri: '/pages/checkin'
          })
        }
      },
      fail: () => {}
    })
  },

  /**
   * 加载设置
   */
  loadSettings() {
    storage.get({
      key: STORAGE_KEYS.USER_SETTINGS,
      success: (data) => {
        if (data) {
          try {
            const settings = JSON.parse(data)
            this.goalSteps = settings.goalSteps || 6000
          } catch (e) {
            console.error('解析设置失败:', e)
          }
        }
      },
      fail: (data, code) => {
        console.error(`读取设置失败: code=${code}`)
      }
    })
  },

  /**
   * 加载缓存数据
   */
  loadCachedData() {
    // 读取最新体征数据
    const latestVital = this.dataCache.getLatestVital()
    if (latestVital) {
      this.heartRate = latestVital.heartRate
      this.spo2 = latestVital.spo2
      this.temperature = latestVital.temperature
      this.updateHealthStatus()
    }

    // 读取今日活动数据
    const activity = this.dataCache.getTodayActivity()
    this.steps = activity.steps
    this.activeMinutes = activity.activeMinutes
    this.calories = activity.calories
  },

  /**
   * 开始数据采集
   */
  startDataCollection() {
    if (this.sensorService && !this.sensorService.isRunning) {
      this.sensorService.start({
        onHeartRate: (data) => {
          this.heartRate = data.heartRate
          this.updateHealthStatus()
          this.cacheVitalData()
          this.checkAlarms()
        },
        onSpO2: (data) => {
          this.spo2 = data.spo2
          this.updateHealthStatus()
          this.cacheVitalData()
          this.checkAlarms()
        },
        onTemperature: (data) => {
          this.temperature = data.temperature
          this.updateHealthStatus()
          this.cacheVitalData()
          this.checkAlarms()
        },
        onAccelerometer: (data) => {
          this.fallDetector.addAcceleration(data)
          this.checkFallDetection()
        },
        onSteps: (data) => {
          this.steps = data.steps
          this.updateActivityStats()
        },
        onLocation: (data) => {
          this.lastLocation = data
        }
      })
    }
  },

  /**
   * 停止数据采集
   */
  stopDataCollection() {
    if (this.sensorService && this.sensorService.isRunning) {
      this.sensorService.stop()
    }
  },

  /**
   * 启动定时器
   */
  startTimers() {
    // 防止重复创建定时器
    this.stopTimers()

    // 每秒更新时间
    this.timeTimer = setInterval(() => {
      this.updateTime()
    }, 1000)

    // 每 5 秒上报一次体征数据
    this.uploadTimer = setInterval(() => {
      this.uploadData()
    }, VITAL_UPLOAD_INTERVAL)

    console.log(`[Index] 体征上报间隔: ${VITAL_UPLOAD_INTERVAL / 1000}s`)

    // 进入首页立即上报一次，之后按间隔持续上报
    this.uploadData()
  },

  /**
   * 停止定时器
   */
  stopTimers() {
    if (this.timeTimer) {
      clearInterval(this.timeTimer)
      this.timeTimer = null
    }
    if (this.uploadTimer) {
      clearInterval(this.uploadTimer)
      this.uploadTimer = null
    }
  },

  /**
   * 清理服务
   */
  cleanupServices() {
    if (this.uploadService) {
      this.uploadService.stop()
    }
    if (this.alarmService) {
      this.alarmService.stop()
    }
    if (this.mqttService) {
      this.mqttService.destroy()
      this.mqttService = null
    }
  },

  /**
   * 更新活动统计数据
   */
  updateActivityStats() {
    // 根据步数估算卡路里和活跃时间
    this.calories = Math.round(this.steps * 0.04)
    this.activeMinutes = Math.round(this.steps / 100)
  },

  /**
   * 更新时间显示
   */
  updateTime() {
    const now = new Date()
    const hours = now.getHours().toString().padStart(2, '0')
    const minutes = now.getMinutes().toString().padStart(2, '0')
    this.currentTime = `${hours}:${minutes}`

    const month = now.getMonth() + 1
    const date = now.getDate()
    const weekDays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
    const weekDay = weekDays[now.getDay()]
    this.currentDate = `${month}月${date}日 ${weekDay}`
  },

  /**
   * 更新健康状态
   */
  updateHealthStatus() {
    // 心率状态
    if (this.heartRate > 0) {
      if (this.heartRate < VITAL_RANGES.heartRate.dangerLow ||
          this.heartRate > VITAL_RANGES.heartRate.dangerHigh) {
        this.heartRateStatus = 'danger'
      } else if (this.heartRate < VITAL_RANGES.heartRate.warningLow ||
                 this.heartRate > VITAL_RANGES.heartRate.warningHigh) {
        this.heartRateStatus = 'warning'
      } else {
        this.heartRateStatus = 'normal'
      }
    }

    // 血氧状态
    if (this.spo2 > 0) {
      if (this.spo2 < VITAL_RANGES.spo2.danger) {
        this.spo2Status = 'danger'
      } else if (this.spo2 < VITAL_RANGES.spo2.warning) {
        this.spo2Status = 'warning'
      } else {
        this.spo2Status = 'normal'
      }
    }

    // 体温状态
    if (this.temperature > 0) {
      if (this.temperature < VITAL_RANGES.temperature.warningLow ||
          this.temperature > VITAL_RANGES.temperature.warningHigh) {
        this.temperatureStatus = 'warning'
      } else {
        this.temperatureStatus = 'normal'
      }
    }

    // 更新健康提示
    this.updateHealthTip()
  },

  /**
   * 更新健康提示
   */
  updateHealthTip() {
    const vitals = {
      heartRate: this.heartRate,
      spo2: this.spo2,
      temperature: this.temperature
    }

    const tip = this.healthRules.checkVitals(vitals)
    if (tip) {
      this.healthTipMessage = tip.message
      this.healthTipLevel = tip.level
    } else {
      this.healthTipMessage = ''
      this.healthTipLevel = 'info'
    }
  },

  /**
   * 缓存体征数据
   */
  cacheVitalData() {
    if (!this.dataCache) return

    const packet = {
      heartRate: this.heartRate,
      spo2: this.spo2,
      temperature: this.temperature,
      timestamp: Date.now(),
      steps: this.steps,
      isAbnormal: this.heartRateStatus === 'danger' ||
                  this.spo2Status === 'danger'
    }

    this.dataCache.addVitalData(packet)
  },

  /**
   * 检查是否需要触发报警
   */
  checkAlarms() {
    const vitals = {
      heartRate: this.heartRate,
      spo2: this.spo2,
      temperature: this.temperature
    }

    const alarm = this.healthRules.shouldTriggerAlarm(vitals)
    if (alarm) {
      this.alarmService.triggerAbnormalAlarm(
        alarm.reason,
        alarm.level,
        vitals
      )
      // 圆表报警提醒页：体征异常时跳转可视化告警
      this.navigateToAlarm(alarm)
    }
  },

  /**
   * 跳转到报警提醒页（带冷却，避免频繁跳转）
   */
  navigateToAlarm(alarm) {
    const now = Date.now()
    if (now - this.lastAlarmNavigateTime < this.alarmNavigateCooldown) {
      return
    }
    this.lastAlarmNavigateTime = now

    const titleMap = {
      '心率严重异常': '心率异常',
      '心率异常': '心率异常',
      '血氧严重异常': '血氧异常',
      '血氧偏低': '血氧异常'
    }

    const messageMap = {
      '心率严重异常': '您的心率严重异常，请立即关注',
      '心率异常': '您的心率偏高',
      '血氧严重异常': '您的血氧严重偏低',
      '血氧偏低': '您的血氧偏低'
    }

    router.push({
      uri: '/pages/alarm',
      params: {
        title: titleMap[alarm.reason] || '体征异常',
        message: messageMap[alarm.reason] || alarm.reason || '检测到身体指标异常',
        level: alarm.level || 'warning'
      }
    })
  },

  /**
   * 检查跌倒检测
   */
  checkFallDetection() {
    if (this.fallDetector.checkFall()) {
      const vitals = {
        heartRate: this.heartRate,
        spo2: this.spo2,
        temperature: this.temperature
      }
      this.alarmService.triggerFallAlarm(vitals)
    }
  },

  /**
   * 上传数据到服务器
   * HTTP: POST /api/v1/vitals/sign
   * MQTT: device/{sn}/vital
   */
  uploadData() {
    if (!this.uploadService) return

    // 5秒一次：上一次请求未返回时跳过本轮，避免请求堆叠
    if (this.uploadBusy) {
      console.log('[Index] 上一次体征上报未完成，跳过本轮')
      return
    }

    // 同步电量到 MqttService（心跳上报用）
    if (this.mqttService && this.batteryLevel >= 0) {
      this.mqttService.setBatteryLevel(this.batteryLevel)
    }

    // 直接上传当前体征数据
    const vitalData = {
      heartRate: this.heartRate,
      spo2: this.spo2,
      temperature: this.temperature,
      steps: this.steps,
      timestamp: Date.now()
    }

    // 仅在有有效数据时上传
    if (vitalData.heartRate > 0 || vitalData.spo2 > 0) {
      const modeTag = this.uploadMode === UPLOAD_MODE.MQTT ? '[MQTT]' : '[HTTP]'

      this.uploadBusy = true
      let released = false
      const release = () => {
        released = true
        this.uploadBusy = false
      }
      // 超时兜底：即使回调未触发也能继续下一轮
      setTimeout(() => {
        if (!released) release()
      }, VITAL_UPLOAD_INTERVAL)

      this.uploadService.uploadVitalSigns(
        vitalData,
        () => {
          release()
          console.log(`${modeTag} 体征数据上报成功 HR=${vitalData.heartRate} SpO2=${vitalData.spo2}`)
        },
        (error) => {
          release()
          console.error(`${modeTag} 体征数据上报失败:`, error)
        }
      )
    }
  },

  /**
   * SOS 按钮按下
   */
  onSOSPress() {
    // 震动提示
    vibrator.vibrate({
      mode: 'short',
      success: () => {},
      fail: () => {}
    })

    // 启动长按计时器
    this.sosPressTimer = setTimeout(() => {
      this.triggerSOS()
    }, this.sosLongPressThreshold)
  },

  /**
   * 触发 SOS 报警
   */
  triggerSOS() {
    const vitals = {
      heartRate: this.heartRate,
      spo2: this.spo2,
      temperature: this.temperature
    }

    this.alarmService.triggerSOS(vitals)
  },

  /**
   * 体征卡片点击
   */
  onVitalTap(type) {
    router.push({
      uri: '/pages/health-detail',
      params: {
        type: type
      }
    })
  },

  /**
   * 打开健康详情
   */
  openHealth() {
    router.push({
      uri: '/pages/health-detail',
      params: { type: 'heartRate' }
    })
  },

  /**
   * 打开 SOS 求助
   */
  openSOS() {
    router.push({
      uri: '/pages/sos'
    })
  },

  /**
   * 打开运动步数
   */
  openSteps() {
    router.push({
      uri: '/pages/steps'
    })
  },

  /**
   * 打开设置
   */
  openSettings() {
    router.push({
      uri: '/pages/settings'
    })
  }
}
</script>
