<template>
  <scroll scroll-y="true" class="page">
    <div class="container">

      <!-- 返回按钮 -->
      <div class="header-row">
        <input type="button" class="back-btn" value="返回" onclick="goBack" />
      </div>

      <!-- 页面标题 -->
      <text class="title">设置</text>

      <!-- 设置列表 -->
      <div class="settings-list">

        <!-- 目标步数 -->
        <div class="setting-item">
          <text class="setting-label">目标步数</text>
          <div class="setting-value-row">
            <input type="button" class="value-btn" value="-" onclick="decreaseGoal" />
            <text class="setting-value">{{goalSteps}}</text>
            <input type="button" class="value-btn" value="+" onclick="increaseGoal" />
          </div>
        </div>

        <!-- 屏幕亮度 -->
        <div class="setting-item">
          <text class="setting-label">屏幕亮度</text>
          <slider class="brightness-slider" value="{{brightness}}" min="10" max="100" onchange="onBrightnessChange" />
        </div>

        <!-- 采集间隔 -->
        <div class="setting-item">
          <text class="setting-label">采集间隔</text>
          <div class="setting-value-row">
            <input type="button" class="value-btn" value="-" onclick="decreaseInterval" />
            <text class="setting-value">{{collectInterval}}秒</text>
            <input type="button" class="value-btn" value="+" onclick="increaseInterval" />
          </div>
        </div>

        <!-- SOS 功能开关 -->
        <div class="setting-item">
          <text class="setting-label">SOS 功能</text>
          <switch checked="{{sosEnabled}}" onchange="onSosToggle" />
        </div>

        <!-- 跌倒检测开关 -->
        <div class="setting-item">
          <text class="setting-label">跌倒检测</text>
          <switch checked="{{fallDetection}}" onchange="onFallDetectionToggle" />
        </div>

        <!-- 数据来源 -->
        <div class="setting-item">
          <text class="setting-label">模拟数据</text>
          <switch checked="{{useMockData}}" onchange="onMockDataToggle" />
        </div>

        <!-- 模拟数据模式 -->
        <div class="setting-item" if="{{ useMockData }}">
          <text class="setting-label">模拟模式</text>
          <div class="setting-value-row">
            <input type="button" class="mode-btn {{ mockMode === 'normal' ? 'mode-active' : '' }}" value="正常" onclick="setMockMode('normal')" />
            <input type="button" class="mode-btn {{ mockMode === 'abnormal' ? 'mode-active' : '' }}" value="异常" onclick="setMockMode('abnormal')" />
            <input type="button" class="mode-btn {{ mockMode === 'fall' ? 'mode-active' : '' }}" value="跌倒" onclick="setMockMode('fall')" />
          </div>
        </div>

        <!-- 设备绑定：序列号（后续可替换为二维码扫码绑定） -->
        <div class="setting-item">
          <text class="setting-label">设备序列号</text>
          <input class="sn-input" type="text" placeholder="EH-WATCH-20260101" value="{{ deviceSnInput }}" onchange="onDeviceSnInput" />
        </div>

        <div class="setting-item">
          <text class="setting-label">绑定状态</text>
          <text class="mqtt-status {{ bindingBound ? 'mqtt-online' : 'mqtt-offline' }}">{{ bindingStatusText }}</text>
        </div>

        <div class="setting-item">
          <text class="setting-label">序列号绑定</text>
          <div class="setting-value-row">
            <input type="button" class="cloud-btn" value="保存绑定" onclick="saveDeviceBinding" />
            <input type="button" class="cloud-btn" value="恢复默认" onclick="resetDeviceBinding" />
          </div>
        </div>

        <div class="setting-item">
          <text class="setting-label">扫码绑定</text>
          <input type="button" class="cloud-btn" value="扫二维码" onclick="scanBind" />
        </div>

        <!-- 上传模式 (调试开关) -->
        <div class="setting-item">
          <text class="setting-label">上传模式</text>
          <div class="setting-value-row">
            <input type="button" class="upload-mode-btn {{ uploadMode === 'http' ? 'upload-active upload-http' : '' }}" value="HTTP" onclick="setUploadMode('http')" />
            <input type="button" class="upload-mode-btn {{ uploadMode === 'mqtt' ? 'upload-active upload-mqtt' : '' }}" value="MQTT" onclick="setUploadMode('mqtt')" />
          </div>
        </div>

        <!-- MQTT 连接状态（仅在 MQTT 模式显示） -->
        <div class="setting-item" if="{{ uploadMode === 'mqtt' }}">
          <text class="setting-label">MQTT 状态</text>
          <text class="mqtt-status {{ mqttConnected ? 'mqtt-online' : 'mqtt-offline' }}">
            {{ mqttConnected ? '已连接' : '未连接' }}
          </text>
        </div>

        <!-- 服务器登录 / WebSocket 状态 -->
        <div class="setting-item">
          <text class="setting-label">服务器</text>
          <text class="mqtt-status {{ cloudWsConnected ? 'mqtt-online' : 'mqtt-offline' }}">
            {{ cloudStatusText }}
          </text>
        </div>

        <div class="setting-item">
          <text class="setting-label">实时通道</text>
          <input type="button" class="cloud-btn" value="{{ cloudBusy ? '连接中…' : '重新连接' }}" onclick="reconnectCloud" />
        </div>

      </div>

      <!-- 保存按钮 -->
      <input type="button" class="save-btn" value="保存设置" onclick="saveSettings" />

      <!-- 功能入口（用于测试各圆表页面） -->
      <div class="quick-entry">
        <input type="button" class="entry-btn" value="语音交互" onclick="openVoice" />
        <input type="button" class="entry-btn" value="每日签到" onclick="openCheckIn" />
      </div>

      <!-- 应用信息 -->
      <div class="app-info">
        <text class="info-text">银发守护 v1.0.0</text>
      </div>

    </div>
  </scroll>
</template>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #000000;
}

.container {
  flex-direction: column;
  padding-top: 60px;
  padding-bottom: 60px;
  padding-left: 50px;
  padding-right: 50px;
}

.header-row {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 16px;
}

.back-btn {
  width: 90px;
  height: 36px;
  background-color: #333333;
  border-radius: 18px;
  font-size: 18px;
  color: #FFFFFF;
}

.title {
  font-size: 28px;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 20px;
  text-align: center;
}

.settings-list {
  flex-direction: column;
  margin-bottom: 16px;
}

.setting-item {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  background-color: #1e293b;
  border-radius: 16px;
  margin-bottom: 12px;
}

.setting-label {
  font-size: 20px;
  color: #e2e8f0;
}

.setting-value-row {
  flex-direction: row;
  align-items: center;
}

.value-btn {
  width: 32px;
  height: 32px;
  background-color: #333333;
  border-radius: 16px;
  font-size: 18px;
  color: #FFFFFF;
}

.setting-value {
  font-size: 18px;
  color: #FFFFFF;
  margin-left: 10px;
  margin-right: 10px;
  min-width: 50px;
  text-align: center;
}

.brightness-slider {
  width: 120px;
  height: 32px;
}

.setting-value-text {
  font-size: 16px;
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 4px;
  padding-bottom: 4px;
  border-radius: 10px;
}

.setting-value-text.mock {
  color: #FFFFFF;
  background-color: #FF9800;
}

.setting-value-text.real {
  color: #FFFFFF;
  background-color: #4CAF50;
}

.mode-btn {
  flex: 1;
  height: 32px;
  background-color: #333333;
  border-radius: 16px;
  font-size: 14px;
  color: #888888;
  margin-left: 4px;
  margin-right: 4px;
}

.mode-btn.mode-active {
  background-color: #4CAF50;
  color: #FFFFFF;
}

.upload-mode-btn {
  width: 70px;
  height: 32px;
  background-color: #333333;
  border-radius: 16px;
  font-size: 14px;
  color: #888888;
  margin-left: 4px;
  margin-right: 4px;
}

.upload-mode-btn.upload-active {
  color: #FFFFFF;
}

.upload-mode-btn.upload-active.upload-http {
  background-color: #2196F3;
}

.upload-mode-btn.upload-active.upload-mqtt {
  background-color: #4CAF50;
}

.mqtt-status {
  font-size: 14px;
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 4px;
  padding-bottom: 4px;
  border-radius: 10px;
}

.mqtt-status.mqtt-online {
  color: #FFFFFF;
  background-color: #4CAF50;
}

.mqtt-status.mqtt-offline {
  color: #FFFFFF;
  background-color: #FF9800;
}

.cloud-btn {
  width: 110px;
  height: 32px;
  background-color: #2196F3;
  border-radius: 16px;
  font-size: 16px;
  color: #FFFFFF;
}

.sn-input {
  width: 180px;
  height: 34px;
  font-size: 14px;
  color: #FFFFFF;
  background-color: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 8px;
  padding-left: 8px;
  placeholder-color: #666666;
}

.save-btn {
  width: 100%;
  height: 40px;
  background-color: #4CAF50;
  border-radius: 20px;
  font-size: 20px;
  color: #FFFFFF;
  margin-bottom: 16px;
}

.quick-entry {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 16px;
}

.entry-btn {
  width: 120px;
  height: 42px;
  margin-left: 10px;
  margin-right: 10px;
  background-color: #334155;
  border-radius: 20px;
  font-size: 18px;
  color: #e2e8f0;
}

.app-info {
  flex-direction: column;
  align-items: center;
}

.info-text {
  font-size: 14px;
  color: #888888;
}
</style>

<script>
import router from '@system.router'
import storage from '@system.storage'
import brightness from '@system.brightness'
import prompt from '@system.prompt'
import cloudService from '../../services/CloudService'
import deviceBinding from '../../services/DeviceBindingService'

export default {
  private: {
    goalSteps: 6000,
    brightness: 80,
    collectInterval: 5,
    sosEnabled: true,
    fallDetection: true,
    useMockData: true,
    mockMode: 'normal',
    // 上传模式
    uploadMode: 'http',
    mqttConnected: false,
    // 云端连接
    cloudLoggedIn: false,
    cloudWsConnected: false,
    cloudStatusText: '未登录',
    cloudBusy: false,
    cloudListener: null,
    // 设备绑定
    deviceSnInput: 'EH-WATCH-20260101',
    bindingBound: false,
    bindingStatusText: '默认'
  },

  onInit() {
    this.loadSettings()
    this.loadUploadMode()
    this.loadMqttStatus()
    this.initCloudStatus()
    this.initDeviceBinding()
  },

  onShow() {
    // 每次显示时刷新 MQTT 状态
    this.loadMqttStatus()
    this.refreshCloudStatus()
    this.refreshDeviceBinding()
  },

  onDestroy() {
    if (this.cloudListener) {
      cloudService.offStatusChange(this.cloudListener)
      this.cloudListener = null
    }
    if (this.bindingListener) {
      deviceBinding.offChange(this.bindingListener)
      this.bindingListener = null
    }
  },

  // ============================================
  // 设备绑定（序列号 / 二维码）
  // ============================================

  initDeviceBinding() {
    this.bindingListener = (status) => this.applyBindingStatus(status)
    deviceBinding.onChange(this.bindingListener)
    this.refreshDeviceBinding()
  },

  refreshDeviceBinding() {
    this.applyBindingStatus(deviceBinding.getStatus())
  },

  applyBindingStatus(status) {
    if (!status) return
    this.deviceSnInput = status.deviceSn
    this.bindingBound = !!status.bound

    if (!status.bound) {
      this.bindingStatusText = '默认'
    } else {
      const way = status.source === 'qrcode' ? '扫码' : '手动'
      const time = status.boundAt ? this.formatBindTime(status.boundAt) : ''
      this.bindingStatusText = way + '绑定' + (time ? ' ' + time : '')
    }
  },

  formatBindTime(ts) {
    const d = new Date(ts)
    const mm = (d.getMonth() + 1).toString().padStart(2, '0')
    const dd = d.getDate().toString().padStart(2, '0')
    const hh = d.getHours().toString().padStart(2, '0')
    const mi = d.getMinutes().toString().padStart(2, '0')
    return `${mm}-${dd} ${hh}:${mi}`
  },

  onDeviceSnInput(evt) {
    const value = evt && (evt.value !== undefined ? evt.value : evt.text)
    if (value !== undefined && value !== null) {
      this.deviceSnInput = String(value).toUpperCase()
    }
  },

  saveDeviceBinding() {
    const result = deviceBinding.bind(this.deviceSnInput, { source: 'manual' })
    prompt.showToast({
      message: result.ok ? `已绑定 ${deviceBinding.getDeviceSN()}` : result.message,
      duration: 1800
    })
    if (!result.ok) return

    this.refreshDeviceBinding()
    this.notifyBindingChanged()
  },

  resetDeviceBinding() {
    deviceBinding.reset()
    prompt.showToast({ message: `已恢复默认 ${deviceBinding.getDeviceSN()}`, duration: 1800 })
    this.refreshDeviceBinding()
    this.notifyBindingChanged()
  },

  /**
   * 扫码绑定入口
   * 当前手表端无扫码能力：接入后把二维码内容传给 applyQrResult() 即可。
   * 二维码内容约定：ehc://bind?sn=<device_sn>&elderly_id=<elderly_id>
   */
  scanBind() {
    prompt.showToast({
      message: '扫码绑定开发中，请先手动输入序列号',
      duration: 2000
    })
  },

  /**
   * 处理二维码内容（手机端扫码 / 服务端下发绑定指令时调用）
   */
  applyQrResult(qrContent) {
    const result = deviceBinding.bindByQRCode(qrContent)
    prompt.showToast({
      message: result.ok ? `扫码绑定成功 ${deviceBinding.getDeviceSN()}` : result.message,
      duration: 1800
    })
    if (!result.ok) return

    this.refreshDeviceBinding()
    this.notifyBindingChanged()
  },

  /**
   * 序列号变化后通知首页重连 MQTT（Topic 依赖 device_sn）
   */
  notifyBindingChanged() {
    storage.set({
      key: 'mqtt_cmd',
      value: 'reconnect',
      success: () => {},
      fail: () => {}
    })
  },

  /**
   * 订阅云端（登录 + WebSocket）状态
   */
  initCloudStatus() {
    cloudService.init()
    this.cloudListener = (state) => this.applyCloudStatus(state)
    cloudService.onStatusChange(this.cloudListener)
    this.refreshCloudStatus()
  },

  refreshCloudStatus() {
    this.applyCloudStatus(cloudService.getStatus())
  },

  applyCloudStatus(state) {
    if (!state) return
    this.cloudLoggedIn = !!state.loggedIn
    this.cloudWsConnected = !!state.wsConnected
    this.cloudBusy = state.wsStatus === 'connecting' || state.wsStatus === 'reconnecting'

    if (!state.loggedIn) {
      this.cloudStatusText = state.lastError ? '连接失败' : '未登录'
    } else if (state.wsConnected) {
      this.cloudStatusText = '在线'
    } else {
      this.cloudStatusText = '重连中'
    }
  },

  /**
   * 手动重新登录并建立 WebSocket
   */
  reconnectCloud() {
    if (this.cloudBusy) return
    this.cloudBusy = true

    cloudService.ensureOnline((err) => {
      this.cloudBusy = false
      this.refreshCloudStatus()
      prompt.showToast({
        message: err ? ('连接失败：' + (err.message || '请检查网络')) : '已连接服务器',
        duration: 1800
      })
    })
  },

  loadSettings() {
    storage.get({
      key: 'user_settings',
      success: (data) => {
        if (data) {
          const settings = JSON.parse(data)
          this.goalSteps = settings.goalSteps || 6000
          this.brightness = settings.brightness || 80
          this.collectInterval = settings.collectInterval || 5
          this.sosEnabled = settings.sosEnabled !== false
          this.fallDetection = settings.fallDetection !== false
          this.useMockData = settings.useMockData !== false
          this.mockMode = settings.mockMode || 'normal'
        }
      },
      fail: (data, code) => {
        console.error('加载设置失败:', code)
      }
    })
  },

  /**
   * 加载上传模式
   */
  loadUploadMode() {
    storage.get({
      key: 'upload_mode',
      success: (data) => {
        if (data === 'http' || data === 'mqtt') {
          this.uploadMode = data
        }
      },
      fail: () => {}
    })
  },

  /**
   * 加载 MQTT 连接状态（由首页 MqttService 写入 storage）
   */
  loadMqttStatus() {
    storage.get({
      key: 'mqtt_status',
      success: (data) => {
        if (data) {
          try {
            const status = JSON.parse(data)
            this.mqttConnected = status.connected === true
          } catch (e) {
            this.mqttConnected = false
          }
        }
      },
      fail: () => {}
    })
  },

  /**
   * 切换上传模式（调试开关）
   */
  setUploadMode(mode) {
    this.uploadMode = mode

    // 持久化上传模式
    storage.set({
      key: 'upload_mode',
      value: mode,
      success: () => {
        // 切到 MQTT 时，发送连接命令给首页
        if (mode === 'mqtt') {
          storage.set({
            key: 'mqtt_cmd',
            value: 'connect',
            success: () => {},
            fail: () => {}
          })
        }

        prompt.showToast({
          message: mode === 'mqtt' ? '已切换到 MQTT 模式' : '已切换到 HTTP 模式',
          duration: 1500
        })
      },
      fail: (data, code) => {
        console.error('保存上传模式失败:', code)
      }
    })
  },

  increaseGoal() {
    if (this.goalSteps < 20000) {
      this.goalSteps += 1000
    }
  },

  decreaseGoal() {
    if (this.goalSteps > 1000) {
      this.goalSteps -= 1000
    }
  },

  onBrightnessChange(evt) {
    this.brightness = evt.value
    brightness.setValue({
      value: this.brightness,
      success: () => {
        console.log('亮度设置成功')
      },
      fail: (data, code) => {
        console.error('亮度设置失败:', code)
      }
    })
  },

  increaseInterval() {
    if (this.collectInterval < 30) {
      this.collectInterval += 5
    }
  },

  decreaseInterval() {
    if (this.collectInterval > 5) {
      this.collectInterval -= 5
    }
  },

  onSosToggle(evt) {
    this.sosEnabled = evt.checked
  },

  onFallDetectionToggle(evt) {
    this.fallDetection = evt.checked
  },

  onMockDataToggle(evt) {
    this.useMockData = evt.checked
  },

  setMockMode(mode) {
    this.mockMode = mode
  },

  saveSettings() {
    const settings = {
      goalSteps: this.goalSteps,
      brightness: this.brightness,
      collectInterval: this.collectInterval,
      sosEnabled: this.sosEnabled,
      fallDetection: this.fallDetection,
      useMockData: this.useMockData,
      mockMode: this.mockMode
    }

    storage.set({
      key: 'user_settings',
      value: JSON.stringify(settings),
      success: () => {
        // 同时保存上传模式
        storage.set({
          key: 'upload_mode',
          value: this.uploadMode,
          success: () => {},
          fail: () => {}
        })

        prompt.showToast({
          message: '设置已保存',
          duration: 2000
        })
      },
      fail: (data, code) => {
        console.error('保存设置失败:', code)
        prompt.showToast({
          message: '保存失败，请重试',
          duration: 2000
        })
      }
    })
  },

  openVoice() {
    router.push({
      uri: '/pages/voice'
    })
  },

  openCheckIn() {
    router.push({
      uri: '/pages/checkin'
    })
  },

  goBack() {
    router.back()
  }
}
</script>
