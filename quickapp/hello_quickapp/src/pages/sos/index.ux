<template>
  <div class="container">
    <!-- 标题 -->
    <text class="sos-title">紧急求助</text>

    <!-- SOS 大按钮：长按触发 -->
    <div class="sos-button {{ sendState === 'ok' ? 'sos-button-ok' : '' }}"
         ontouchstart="onSOSPress"
         ontouchend="onSOSRelease">
      <text class="sos-label" if="{{ sendState === 'idle' }}">SOS</text>
      <text class="sos-label" if="{{ sendState === 'sending' }}">发送中…</text>
      <text class="sos-label sos-result-label" if="{{ sendState === 'ok' }}">已报警</text>
      <text class="sos-label sos-result-label" if="{{ sendState === 'fail' }}">发送失败</text>
    </div>

    <!-- 底部提示 -->
    <text class="sos-hint" if="{{ sendState === 'idle' }}">长按触发</text>
    <text class="sos-hint" if="{{ sendState === 'sending' }}">正在联系家人</text>
    <text class="sos-hint" if="{{ sendState === 'ok' }}">已通知家人与工作人员</text>
    <text class="sos-hint" if="{{ sendState === 'fail' }}">已保存本地，网络恢复后自动重发</text>
  </div>
</template>

<style>
.container {
  width: 466px;
  height: 466px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #7f1d1d 0%, #450a0a 100%);
  padding-top: 70px;
  padding-bottom: 70px;
  padding-left: 60px;
  padding-right: 60px;
}

.sos-title {
  font-size: 32px;
  color: #fca5a5;
  font-weight: 700;
  margin-bottom: 28px;
}

.sos-button {
  width: 200px;
  height: 200px;
  border-radius: 100px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #ef4444 0%, #b91c1c 100%);
  border-width: 6px;
  border-color: #f87171;
}

.sos-label {
  font-size: 56px;
  color: #ffffff;
  font-weight: 700;
}

.sos-result-label {
  font-size: 40px;
}

.sos-button-ok {
  background: linear-gradient(180deg, #22c55e 0%, #15803d 100%);
  border-color: #86efac;
}

.sos-hint {
  font-size: 22px;
  color: #fca5a5;
  margin-top: 28px;
}
</style>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import geolocation from '@system.geolocation'
import storage from '@system.storage'
import { STORAGE_KEYS, ALARM_LEVELS } from '../../utils/constants'
import UploadService from '../../services/UploadService'
import AlarmService from '../../services/AlarmService'
import cloudService from '../../services/CloudService'

export default {
  protected: {
    sosData: ''
  },

  private: {
    isTriggered: false,
    // 发送状态：idle(待触发) / sending(发送中) / ok(已报警) / fail(发送失败)
    sendState: 'idle',
    heartRate: '--',
    spo2: '--',
    temperature: '--',
    hasLocation: false,
    sosPacket: null,
    uploadService: null,
    alarmService: null,
    longPressTimer: null,
    longPressThreshold: 1500
  },

  onInit() {
    this.initServices()
    this.parseSOSData()
  },

  onDestroy() {
    this.stopLongPress()
    this.cleanupServices()
  },

  /**
   * 初始化服务
   */
  initServices() {
    this.uploadService = new UploadService()
    this.uploadService.init({})

    this.alarmService = new AlarmService(this.uploadService)
    this.alarmService.init({})

    // 确保已登录服务器并建立 WebSocket（报警指令优先走实时通道）
    cloudService.start()
  },

  /**
   * 解析 SOS 数据
   */
  parseSOSData() {
    if (this.sosData) {
      try {
        this.sosPacket = JSON.parse(this.sosData)
        // 兼容 AlarmService 上报包（heart_rate）与本页默认包（heartRate）
        const hr = this.sosPacket.heartRate || this.sosPacket.heart_rate
        const ox = this.sosPacket.spo2
        const temp = this.sosPacket.temperature
        this.heartRate = hr > 0 ? hr : '--'
        this.spo2 = ox > 0 ? ox : '--'
        this.temperature = temp > 0 ? temp : '--'
        this.hasLocation = !!(this.sosPacket.location || this.sosPacket.latitude)

        // 带报警数据进入页面（SOS 长按/跌倒检测/规则报警）：
        // 由本页面统一上报并显示"已报警/发送失败"结果
        this.uploadAlarmData(this.sosPacket)
      } catch (e) {
        console.error('解析 SOS 数据失败:', e)
        this.initDefaultData()
      }
    } else {
      this.initDefaultData()
    }
  },

  /**
   * 初始化默认数据
   */
  initDefaultData() {
    this.sosPacket = {
      type: 'sos',
      level: 'P0',
      timestamp: Date.now(),
      heartRate: -1,
      spo2: -1,
      temperature: -1,
      location: null,
      context: {
        triggerType: 'manual',
        deviceTime: Date.now()
      }
    }

    this.getCurrentLocation()
  },

  /**
   * 获取当前位置
   */
  getCurrentLocation() {
    geolocation.getLocation({
      success: (data) => {
        this.sosPacket.location = {
          latitude: data.latitude,
          longitude: data.longitude
        }
        this.hasLocation = true
      },
      fail: (data, code) => {
        console.error(`获取位置失败: code=${code}`)
        this.hasLocation = false
      }
    })
  },

  /**
   * 停止长按计时
   */
  stopLongPress() {
    if (this.longPressTimer) {
      clearTimeout(this.longPressTimer)
      this.longPressTimer = null
    }
  },

  /**
   * SOS 按钮按下（启动长按计时）
   */
  onSOSPress() {
    vibrator.vibrate({
      mode: 'short',
      success: () => {},
      fail: () => {}
    })

    this.longPressTimer = setTimeout(() => {
      this.triggerSOS()
    }, this.longPressThreshold)
  },

  /**
   * SOS 按钮松开（取消长按）
   */
  onSOSRelease() {
    this.stopLongPress()
  },

  /**
   * 触发 SOS 报警
   */
  triggerSOS() {
    // 发送中时忽略重复触发，完成后可再次长按补发
    if (this.sendState === 'sending') return

    this.stopLongPress()
    this.isTriggered = true
    this.sendState = 'sending'

    vibrator.vibrate({
      mode: 'long',
      success: () => {},
      fail: (data, code) => {
        console.error(`震动失败: code=${code}`)
      }
    })

    // 构建符合服务器协议的报警包（alarm_type=SOS, severity=P0）
    const alarmPacket = this.buildAlarmPacket()
    this.sosPacket = alarmPacket

    this.saveAlarmRecord(alarmPacket)
    this.uploadAlarmData(alarmPacket)
  },

  /**
   * 构建报警数据包
   * 字段匹配：POST /v1/alarms/report
   */
  buildAlarmPacket() {
    const vitals = {
      heartRate: this.heartRate !== '--' ? this.heartRate : 0,
      spo2: this.spo2 !== '--' ? this.spo2 : 0,
      temperature: this.temperature !== '--' ? this.temperature : 0
    }
    // 位置：兼容本页包（location 对象）与 AlarmService 包（latitude/longitude）
    let location = null
    if (this.sosPacket) {
      if (this.sosPacket.location) {
        location = this.sosPacket.location
      } else if (this.sosPacket.latitude) {
        location = { latitude: this.sosPacket.latitude, longitude: this.sosPacket.longitude }
      }
    }

    const packet = this.uploadService.buildAlarmPacket(
      'sos',
      ALARM_LEVELS.P0,
      vitals,
      location,
      { trigger: 'MANUAL_LONG_PRESS' }
    )
    packet.description = '用户长按 SOS 按键触发紧急求助'
    return packet
  },

  /**
   * 保存报警记录
   */
  saveAlarmRecord(packet) {
    const record = packet || this.sosPacket
    storage.get({
      key: STORAGE_KEYS.SOS_RECORDS,
      success: (data) => {
        let records = []
        if (data) {
          try {
            records = JSON.parse(data)
          } catch (e) {
            records = []
          }
        }

        records.push(record)

        if (records.length > 100) {
          records = records.slice(-100)
        }

        storage.set({
          key: STORAGE_KEYS.SOS_RECORDS,
          value: JSON.stringify(records),
          success: () => {},
          fail: () => {
            console.error('保存报警记录失败')
          }
        })
      },
      fail: () => {
        console.error('读取报警记录失败')
        storage.set({
          key: STORAGE_KEYS.SOS_RECORDS,
          value: JSON.stringify([record]),
          success: () => {},
          fail: () => {
            console.error('保存报警记录失败')
          }
        })
      }
    })
  },

  /**
   * 上传报警数据
   *   - WebSocket 在线：立即下发报警指令
   *   - HTTP：写入 alarm_records（保证报警不丢）
   * 上传结果驱动界面：成功显示"已报警"，失败显示"发送失败"（本地已保存）
   */
  uploadAlarmData(packet) {
    const alarmPacket = packet || this.sosPacket
    let returned = false

    this.isTriggered = true
    this.sendState = 'sending'

    const finish = (ok) => {
      // 结果可多次更新（超时先到、成功后到），但只安排一次返回
      this.sendState = ok ? 'ok' : 'fail'
      if (returned) return
      returned = true
      // 展示结果片刻后返回首页
      setTimeout(() => {
        this.returnToHome()
      }, 2500)
    }

    this.uploadService.uploadAlarm(
      alarmPacket,
      () => {
        console.log('[SOS] 报警已送达服务器')
        finish(true)
      },
      (err) => {
        console.warn('[SOS] 报警发送失败: ' + (err || 'unknown'))
        finish(false)
      }
    )

    // 超时兜底：避免网络极慢时页面一直停在"发送中"
    setTimeout(() => {
      if (this.sendState === 'sending') finish(false)
    }, 8000)
  },

  /**
   * 返回首页
   */
  returnToHome() {
    router.back()
  },

  /**
   * 清理服务
   */
  cleanupServices() {
    if (this.uploadService) {
      this.uploadService.stop()
    }
    if (this.alarmService) {
      this.alarmService.stop()
    }
    vibrator.stop({
      success: () => {},
      fail: () => {}
    })
  }
}
</script>
